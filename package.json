{
  "name": "slidev-theme-ice",
  "version": "0.0.1",
  "description": "ICE Malta course material theme for Slidev",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev",
    "ice",
    "ice-malta"
  ],
  "engines": {
    "slidev": ">=52.0.0"
  },
  "scripts": {
    "demo": "slidev example/slides.md --open",
    "demo:build": "slidev build example/slides.md",
    "slide": "node scripts/slide.mjs --out example/slides.md"
  },
  "dependencies": {
    "appshots": "^1.2.1",
    "qrcode.vue": "^3.9.1"
  },
  "devDependencies": {
    "@slidev/cli": "^52.19.0",
    "vue": "^3.5.13"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "dompurify": "^3.4.13",
    "js-yaml@4": "^4.3.1"
  },
  "allowScripts": {
    "sharp": false
  },
  "files": [
    "assets",
    "components",
    "composables",
    "example",
    "layouts",
    "scripts",
    "setup",
    "starter",
    "styles",
    "templates",
    "uno.config.ts"
  ],
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "highlighter": "shiki",
      "transition": "slide-left",
      "canvasWidth": 1920,
      "aspectRatio": "16/9"
    }
  },
  "bin": {
    "ice-slide": "scripts/slide.mjs",
    "ice-deck-init": "scripts/init.mjs"
  }
}
